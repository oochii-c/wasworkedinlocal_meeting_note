# ── 제공자 선택 ─────────────────────────────
STT_PROVIDER=groq        # groq | openai | hf | local(whisper)
SUMMARY_PROVIDER=groq    # groq | hf | ollama
# hf 선택 시 실패(크레딧 소진/만료)하면 groq로 자동 폴백(GROQ_API_KEY 필요)

# ── API 키 (쓰는 제공자 것만 채우면 됨) ──────
# 이 키는 서버에만 있음 = 브라우저에 노출 안 됨.
GROQ_API_KEY=
OPENAI_API_KEY=
HF_TOKEN=

# ── 모델 (기본값 있음, 바꿀 때만) ────────────
GROQ_STT_MODEL=whisper-large-v3
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
OLLAMA_MODEL=llama3.2:3b
LOCAL_WHISPER_MODEL=base

# PORT=5000
